HCNTH		EQU	05h
VCNTL		EQU	06h
VCNTH		EQU	07h
SCROLL1		EQU	08h
SCROLL2		EQU	09h
SCROLL3		EQU	0Ah
ACK		EQU	0Bh
MODE		EQU	0Ch
BORDL		EQU	0Dh
BORDH		EQU	0Eh
PMASK		EQU	0Fh
INDEX		EQU	10h
ENDL		EQU	11h
ENDH		EQU	12h
MEM		EQU	13h
GPR		EQU	14h
DIAG		EQU	15h
DIS		EQU	16h
HLPL		EQU	00h
HLPH		EQU	01h
VLPL		EQU	02h
VLPH		EQU	03h
STATUS		EQU	04h

; Blitter locations

BLPROG0		EQU	30h
BLPROG1		EQU	31h
BLPROG2		EQU	32h
BLCMD		EQU	33h
BLCON		EQU	34h
BLDEST0		EQU	20h
BLDEST1		EQU	21h
BLDEST2		EQU	22h
BLSRC0		EQU	23h
BLSRC1		EQU	24h
BLSRC2		EQU	25h
BLSTAT		EQU	26h
